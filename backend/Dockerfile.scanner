# Complyr scanner worker image (Spring profile `scanner`, no web server, no inbound ports).
# Build context: backend/ — e.g. `docker build -t complyr-scanner -f backend/Dockerfile.scanner backend/`
# Base image ships the Playwright browsers + system deps for Playwright for Java (W4).

FROM gradle:jdk21 AS build
WORKDIR /workspace

COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle/ gradle/
RUN gradle dependencies --no-daemon --quiet > /dev/null 2>&1 || true

COPY . .
RUN gradle bootJar -x test --no-daemon

FROM mcr.microsoft.com/playwright/java:v1.61.0-noble AS runtime

COPY --from=build /workspace/build/libs/*.jar /app/app.jar

# pwuser is the non-root user shipped by the Playwright base image.
USER pwuser

# ENV (not a CLI arg): CLI args are the highest-priority PropertySource and
# would silently override the compose-provided SPRING_PROFILES_ACTIVE
# (e.g. `scanner,prd`). ENV stays overridable.
ENV SPRING_PROFILES_ACTIVE=scanner

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
