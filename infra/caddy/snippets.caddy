# CookieKeeper — Caddy snippets shared by Caddyfile.dev and Caddyfile.prd.
#
# Imported (textually) at the top of each environment's Caddyfile, so a change to
# the security baseline or the consent body cap lands in BOTH environments or
# neither. Since ADR-24 each environment has its own machine and therefore its own
# Caddy instance; this file is what stops them drifting apart.
#
# Mounted read-only next to the Caddyfile at /etc/caddy/snippets.caddy — `import`
# resolves relative to the importing file's directory.

# --- Public consent ingestion: cap body at the edge -------------------------
# POST /api/v1/consent is public, unauthenticated and CORS-open. A legitimate
# consent event is a few hundred bytes; 8KB is generous. Rejecting oversized
# bodies here (413) keeps hostile payloads off the app entirely — the Jackson
# stream limits in the backend are the in-process backstop, not the front line.
(consent_body_cap) {
	@consent path /api/v1/consent
	request_body @consent {
		max_size 8KB
	}
}

# --- Shared security headers (web security baseline) -------------------------
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# CSP is intentionally NOT set here: the dashboard emits a nonce-based CSP
	# per request (app-level), and the widget CDN must stay embeddable anywhere.
}

# --- CDN vhosts: widget bundle from disk, per-site config from the API -------
# args: {args[0]} = disk root for the widget bundle, {args[1]} = api upstream.
#
# CI uploads content-hashed/versioned assets; cache hard, Cloudflare absorbs the
# read load. Per-site config (/cfg/{siteKey}.json) is NOT a file: it is proxied
# to the API, which renders the published banner config live (ADR-19). Its
# Cache-Control (public, max-age=300) is set by the API on the response, so the
# TTL lives next to the code that knows when a config changes.
(cdn_site) {
	encode gzip zstd
	import security_headers
	handle /cfg/* {
		# CORS for this route is emitted by the API (Spring), not here — two
		# Access-Control-Allow-Origin headers on one response is a browser error.
		reverse_proxy {args[1]}
	}
	handle {
		root * {args[0]}
		file_server
		header Access-Control-Allow-Origin "*"
		# The stable embed URLs (/v1.js, future /v2.js) are OVERWRITTEN in place by
		# deploys — a long/immutable TTL here would pin a buggy widget in browsers
		# and Cloudflare for a year with no cache-busting lever left.
		@entry path /v*.js
		header @entry Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		# Everything else must be content-hashed — only then is immutable safe.
		header ?Cache-Control "public, max-age=31536000, immutable"
	}
	# X-Frame-Options DENY is fine here — the widget is a <script>, not a frame.
}
