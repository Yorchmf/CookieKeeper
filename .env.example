# =============================================================================
# CookieKeeper environment variables
# =============================================================================
# There are exactly TWO environments: dev and prd. This same file is the template for both,
# and for a workstation:
#
#   workstation  → copy to ./.env in the repo root; infra/compose.workstation.yml reads it
#   dev          → /opt/cookiekeeper/dev/.env on the dev APP host, edited by hand (chmod 600)
#   prd          → /opt/cookiekeeper/prd/.env on the prd APP host, edited by hand (chmod 600)
#
# Secrets are NEVER in git, never in Terraform (tfvars land in state in plaintext) and never in a
# GitHub Actions variable. They are typed into the .env on the host and nothing else touches them —
# deploy.sh only ever writes .env.deploy (image tag, environment, subnet, digest pins) alongside it.
#
# DO NOT put these in a server .env — they are machine-owned and deploy.sh derives and EXPORTS them
# on every deploy, so a value here is either ignored or actively wrong:
#   ENV_NAME, APP_SUBNET   derived from the dev|prd argument. APP_SUBNET in particular must match
#                          the egress firewall's rules (ADR-18); deploy.sh aborts if it does not.
#   COMPOSE_PROFILES       gates the dev-only Mailpit container. `dev` on a prd box starts Mailpit,
#                          which then swallows real customer mail — and `up --remove-orphans` will
#                          NOT clean it up again. deploy.sh exports an empty value on prd to
#                          neutralise a stray one, and refuses to deploy if Mailpit is running.
#   API_DIGEST, SCANNER_DIGEST, DASHBOARD_DIGEST   image pins, set by the release workflow.
#
# NEVER commit real values — .env files are gitignored (CLAUDE.md constraint #7).
# Images are identical across dev/prd; ALL config differences live here.
# =============================================================================

# --- Database (Postgres 16) --------------------------------------------------
# On a DEPLOYED environment the database is a dedicated machine on the private network (ADR-24),
# NOT a container. Use its private address — dev 10.20.10.20, prd 10.20.20.20 — and keep the TLS
# parameters:
#   sslmode=verify-ca   the server must present a certificate that pgca.crt signed. Not
#                       verify-full: that also matches the hostname, and we connect to an IP.
#   sslrootcert         pgca.crt, copied by hand from the database host (server-setup.md §3) and
#                       mounted read-only by compose. It is the ONLY trust anchor for this
#                       connection, so it is deliberately not part of the rsynced deploy.
# The role password is set by hand on the database host; cloud-init creates the role WITHOUT one,
# so a fresh box refuses every connection until someone does (fail closed).
#
#   dev  DB_URL=jdbc:postgresql://10.20.10.20:5432/cookiekeeper?sslmode=verify-ca&sslrootcert=/etc/ssl/pgca.crt
#   prd  DB_URL=jdbc:postgresql://10.20.20.20:5432/cookiekeeper?sslmode=verify-ca&sslrootcert=/etc/ssl/pgca.crt
#
# The value below is the WORKSTATION one: compose.workstation.yml still runs a throwaway Postgres
# container, because a laptop has no private network and nothing in it is real data.
DB_URL=jdbc:postgresql://postgres:5432/cookiekeeper
DB_USER=cookiekeeper
DB_PASSWORD=change-me
# Consumed by the workstation-only postgres container (must match DB_USER/DB_PASSWORD).
# Leave these OUT of a dev/prd .env: there is no postgres container there to configure, and a
# stale copy of the password is exactly the kind of thing that gets rotated in only one place.
POSTGRES_DB=cookiekeeper
POSTGRES_USER=cookiekeeper
POSTGRES_PASSWORD=change-me

# --- Auth ---
# HMAC secret for JWT signing (access 15min + rotating refresh tokens).
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# `Secure` flag on the session cookies. Defaults to TRUE, which is what both deployed environments
# want. Set it to false ONLY in a workstation .env: a browser silently discards a Secure cookie
# delivered over http://localhost, so login would appear to succeed and never stick.
COOKIE_SECURE=true

# --- Consent event IP hashing (no raw IPs at rest — rotating daily salt) ---
IP_HASH_SALT=change-me

# --- Consent origin token (stateless HMAC anti-replay for the public consent path, ADR-13) ---
# HMAC secret (>= 32 bytes). Stable config, NOT per-process: a restart must not reject a token
# minted just before a deploy. Generate with: openssl rand -base64 48
CONSENT_ORIGIN_TOKEN_SECRET=change-me
# Token lifetime (bounds replay). Optional — defaults to 2m.
CONSENT_ORIGIN_TOKEN_TTL=2m

# --- Consent-log retention (ADR-16) ---
# Months of consent evidence to keep before ConsentEventPartitionReaper DROPs the old monthly
# partition. Tenant-blind + irreversible, so it MUST be >= the longest plan retention (3 yr = 36) —
# that 36 is the enforced startup floor (a lower value would irreversibly drop evidence a paying
# customer is still entitled to). Optional — defaults to 36; raise (e.g. 60) for a longer window.
CONSENT_RETENTION_MONTHS=36
# Retention-drop schedule (Spring cron, server zone). Optional — defaults to 04:00 daily.
CONSENT_RETENTION_DROP_CRON=0 0 4 * * *

# --- Banner-impression counters (Track 4 Slice D) ---
# How long the per-(site, day) impression counters are kept before BannerImpressionReaper prunes
# them. A disposable aggregate with no personal data, read only over the dashboard's analytics
# windows, so this only needs to exceed the widest window (~30d). Optional — defaults to 90d.
IMPRESSION_RETENTION=90d
# Prune schedule (Spring cron, server zone). Optional — defaults to 03:45 daily (staggered off the
# consent idempotency prune at 03:30 so the nightly reapers don't overlap).
IMPRESSION_PRUNE_CRON=0 45 3 * * *

# --- Backups (infra/scripts/backup.sh + restore-drill.sh; NOT read by the app) ---
# These live in /opt/cookiekeeper/backup.env on the DATABASE host — not on the app host and not in
# this file's deployed copies. backup.sh runs where Postgres runs (ADR-24), so its dump goes over a
# local unix socket and the app host never holds a read-everything credential. Kept here so every
# backup knob stays documented in one place. See server-setup.md §7.
# The environment name is DERIVED from the hostname (cookiekeeper-{dev,prd}-db); set BACKUP_ENV
# only if a machine was renamed. Off-site objects are filed under a per-environment prefix, so the
# two hosts cannot rotate away each other's copies.
# age PUBLIC key(s) the dump is encrypted to (space-separate for a break-glass 2nd key).
# The matching PRIVATE identity stays OFFLINE — the database host can write backups, never read them.
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# rclone remote:bucket for off-site copies — MUST be an EU region (constraint #2). Blank = local-only.
BACKUP_RCLONE_REMOTE=hetzner-s3:cookiekeeper-backups
# Rotation windows (days). Optional — default 14 local (fast restore) / 90 off-site (disaster).
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_OFFSITE_RETENTION_DAYS=90

# --- Stripe (billing) ---
# Per-environment: a workstation and dev use Stripe TEST mode (sk_test_/whsec_/test-mode price_ ids),
# prd uses LIVE mode (sk_live_/whsec_/live price_ ids). A test-mode price id is invalid against a live
# key and vice versa, so never share values across environments. The backend fails fast at startup if
# the secret key or any price id is unset.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Price ids, one per plan (create the Products/Prices in the Stripe Dashboard, per mode).
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
# Enable Stripe Tax on Checkout. Requires Stripe Tax configured on the account; leave false where it
# isn't. Optional — defaults to true.
STRIPE_AUTOMATIC_TAX=false

# --- Transactional email. Provider selects the backend EmailSender bean. ---
#   smtp  (default) → Mailpit. Used on a workstation AND on the deployed dev host, where
#                     infra/compose.yml's `dev` profile runs a Mailpit container. Nothing sent
#                     may reach a real inbox: a test signup must never mail a real person
#                     (constraint #4), and dev traffic must not burn Brevo's sending reputation.
#   brevo           → Brevo's EU HTTP API. PRD ONLY — it is the only environment that sends
#                     mail to real people. Setting this in dev defeats the point of Mailpit.
MAIL_PROVIDER=smtp
# From address + display name used on every sent email.
MAIL_FROM=no-reply@cookiekeeper.eu
BREVO_SENDER_NAME=CookieKeeper
# Destination inbox for in-app support contact-form messages. Our own address (not customer PII); the
# submitting customer's email rides the message's Reply-To so a reply reaches them directly.
SUPPORT_INBOX=support@cookiekeeper.eu
# Brevo (EU processor). Required when MAIL_PROVIDER=brevo, i.e. in PRD — the app fails fast at
# startup if unset. Leave the placeholder on a workstation and on dev; neither one needs a real key.
# EU-RESIDENCY (ADR-14, constraint #2): the Brevo account this key belongs to MUST be provisioned in
# Brevo's EU data region. The base URL below does NOT pin residency — region is set on the account.
BREVO_API_KEY=xkeysib-xxx
# Brevo API host; override only to point at a mock. Defaults to https://api.brevo.com.
BREVO_BASE_URL=https://api.brevo.com
# Mailpit's SMTP endpoint (used when MAIL_PROVIDER=smtp). `mailpit` is the compose service name on
# both a workstation and the dev host, so the same value works in each. Read the captured mail at
# http://localhost:8025 locally, or through an SSH tunnel on dev (docs/DEPLOYMENT.md §7.6).
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Domains ---
# prd:  app.cookiekeeper.eu / api.cookiekeeper.eu / cdn.cookiekeeper.eu
# dev:  dev.cookiekeeper.eu / api.dev.cookiekeeper.eu / cdn.dev.cookiekeeper.eu
# These hostnames are also declared in infra/terraform/environments/{dev,prd}.tfvars, which is what
# creates their DNS records — keep the two in sync.
# Used by the BACKEND (email links, hosted policy URLs, CORS).
# The values below are the WORKSTATION ones; on an app host set the real https:// hostnames.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
CDN_BASE_URL=http://localhost:8081

# --- Dashboard ---
# The deployed dashboard needs NO API URL: the client calls same-origin
# /api/v1/* and Caddy proxies to the backend (one image for dev+prd).
# On a workstation the Next SERVER proxies those calls instead —
# API_PROXY_TARGET is set in dashboard/.env.local (bare `pnpm dev`) or by
# infra/compose.workstation.yml, not here. The widget derives its endpoints
# from its own <script src> origin — no config needed.

# --- Backend runtime ---
# Two comma-separated parts: the ROLE (api | scanner) and the ENVIRONMENT (dev | prd).
# Each container sets its own; kept here for reference. A workstation runs the `dev` environment
# profile against this file — that is the only difference from the deployed dev.
SPRING_PROFILES_ACTIVE=api,dev

# --- Backend capacity tuning (CX22 2 vCPU/4GB, dev+prd co-resident; see infra/load/) ---
# All optional — the application.yml defaults below are CX22-sized. Override + re-run
# the load smoke test (infra/load/README.md) to tune. Keep DB_POOL_MAX summed across
# every connecting service (2x api + scanner) under Postgres max_connections (~100).
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=10000
SERVER_TOMCAT_MAX_THREADS=50
SERVER_TOMCAT_MIN_SPARE_THREADS=5
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_MAX_CONNECTIONS=2000

# --- Domain verification (ADR-17) ---
# Bounds on the ONE app-initiated outbound request to a customer-controlled host (the `api`
# container fetching a homepage to look for the embed snippet). It runs synchronously while a
# user waits, holding one of SERVER_TOMCAT_MAX_THREADS above — these are safety limits, not
# tuning knobs, and every one is range-checked at startup. All optional; defaults shown.
# Budget a verify at roughly TOTAL_BUDGET + ~6x DNS_TIMEOUT (the JDK applies the DNS timeout
# per nameserver per retry, and it sits outside the HTTP budget).
VERIFICATION_CONNECT_TIMEOUT=5s
VERIFICATION_REQUEST_TIMEOUT=5s
VERIFICATION_TOTAL_BUDGET=10s
VERIFICATION_MAX_REDIRECTS=3
VERIFICATION_MAX_BODY_BYTES=524288
VERIFICATION_DNS_TIMEOUT=2s

# --- Deploy (written by infra/scripts/deploy.sh on the server — do NOT set these by hand) ---
# GHCR image tag to run. The release workflows always pass a release tag like v1.2.3; deploy.sh
# writes it to .env.deploy so this secrets file is never rewritten by automation.
IMAGE_TAG=v0.1.0
# GHCR owner/org for image names ghcr.io/<owner>/cookiekeeper-{api,scanner,dashboard}
GHCR_OWNER=your-github-user

# --- Observability (Sentry, free tier; optional — blank disables error tracking) ---
# GDPR data residency (ADR-15): use a Sentry EU-region DSN ONLY (host *.de.sentry.io). Both the backend
# and the dashboard REFUSE a non-EU DSN at startup. No PII is ever sent (send-default-pii off + scrub).
# Leave the DSN blank to run with error tracking OFF (the workstation default).
SENTRY_DSN_BACKEND=
# Dashboard DSN. A Sentry DSN is a PUBLIC ingest key (not a secret), so the browser bundle reads it as
# NEXT_PUBLIC_SENTRY_DSN — it is inlined at `next build` time (pass it as a build arg in CI to enable
# browser capture). The dashboard SERVER reads the same var at runtime. EU region only.
NEXT_PUBLIC_SENTRY_DSN=
# Free-form Sentry environment tag for the BACKEND + dashboard server runtime. Not a Spring profile —
# use `workstation`, `dev` or `prd` so a laptop's errors don't pollute the dev environment's issues.
# The dashboard BROWSER derives its environment from the hostname (one build image serves all).
SENTRY_ENVIRONMENT=workstation
# Optional release marker (e.g. the deployed IMAGE_TAG) used by the backend + dashboard server.
SENTRY_RELEASE=
# Performance-tracing sample fraction [0.0-1.0]; 0.0 disables tracing (backend + dashboard server).
SENTRY_TRACES_SAMPLE_RATE=0.0
