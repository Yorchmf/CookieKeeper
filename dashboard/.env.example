# Backend origin the Next server proxies /api/v1/* to (no trailing slash).
# The dashboard client always calls same-origin relative /api/v1/* paths, so
# the httpOnly auth cookies stay first-party. This server-side variable makes
# Next forward those calls to the backend (next.config.ts rewrite; read when
# the server config is loaded — `pnpm dev` startup, or `next build` for the
# Docker image). Deployed environments (dev/prd) leave it UNSET: Caddy
# proxies /api/v1 on the app domain to the backend.
API_PROXY_TARGET=http://localhost:8080

# --- Sentry error tracking (ADR-15; optional — blank disables it) ---
# A Sentry DSN is a PUBLIC ingest key, so the browser bundle reads it from NEXT_PUBLIC_SENTRY_DSN
# (inlined at `next build`; the server also reads it at runtime). EU region ONLY (host *.de.sentry.io) —
# both client and server refuse a non-EU DSN (GDPR data residency, CLAUDE.md #2). Blank => tracking off.
NEXT_PUBLIC_SENTRY_DSN=
# Server-runtime environment tag (local|dev|prd); the browser derives its own from the hostname.
SENTRY_ENVIRONMENT=local
# Optional release marker + server-side perf-trace sample fraction [0.0-1.0] (0 = tracing off).
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Source-map upload (disabled by default) needs these; leave unset for the MVP.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Public marketing site ---
# Canonical public origin used for SEO metadata, hreflang alternates, JSON-LD,
# sitemap.xml and robots.txt. No trailing slash. Set per environment
# (e.g. https://dev.complyr.eu for dev). Defaults to https://complyr.eu.
NEXT_PUBLIC_SITE_URL=https://complyr.eu

# Support address behind every contact link (FAQ, footer, in-app sidebar).
# Public by nature — inlined into the client bundle. Defaults to support@complyr.eu;
# override to point a staging build at a test inbox.
NEXT_PUBLIC_SUPPORT_EMAIL=support@complyr.eu
