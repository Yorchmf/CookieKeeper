# Base URL of the Complyr backend REST API (no trailing slash).
# ONLY needed for bare `pnpm dev` against a locally running backend.
# Deployed environments (dev/prd) leave this UNSET: the client calls
# same-origin /api/v1/* and Caddy proxies to the backend — that keeps one
# image valid for both environments (NEXT_PUBLIC_* is baked at build time).
NEXT_PUBLIC_API_URL=http://localhost:8080
